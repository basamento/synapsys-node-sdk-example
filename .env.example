# Copy to .env and fill in, or export these in your shell.
# The SDK reads every setting from the environment when the options object omits it.

# Required. Base URL of your Synapsys Core instance.
SYNAPSYS_CORE_URL=http://localhost:8080

# Required by Core, which rejects heartbeats without it.
# Create one in the Core console under worker tokens.
SYNAPSYS_CORE_TOKEN=syn_replace_me

# Optional. Defaults are set per entry point.
# SYNAPSYS_WORKER_NAME=node-example
# SYNAPSYS_HEARTBEAT_INTERVAL=5s
# SYNAPSYS_LOG_LEVEL=info

# Set false to disable the SDK completely: no timer, no network, no stream
# interception. Useful for running this app without a Core at all.
# SYNAPSYS_ENABLED=false

# Port for the status page. Each entry point has its own default.
# PORT=3000

# Opt in to the deliberately broken process that blocks the event loop.
# EXAMPLE_ENABLE_HOG=true

# Bulk fixture sizing (npm run start:bulk).
# EXAMPLE_ENDLESS=100
# EXAMPLE_PROGRESSIVE=100
# EXAMPLE_QUIET=false
